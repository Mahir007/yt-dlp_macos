#!/bin/bash
# A fake MacPorts. Installed ports are files in $FAKE_STATE/port holding
# what `port installed` shows after the name, such as "@1.0_0 (active)".
# Every call is logged to $FAKE_STATE/calls. Creating $FAKE_STATE/fail/NAME
# makes installing or uninstalling NAME fail. `port select` choices are files
# in $FAKE_STATE/select. Changes need the fake sudo.
set -u
state=$FAKE_STATE/port
echo "port $*" >>"$FAKE_STATE/calls"

need_root() {
    if [[ -z ${FAKE_AS_ROOT-} ]]; then
        echo "Error: Insufficient privileges to write to MacPorts install prefix." >&2
        exit 1
    fi
}

fail_if_asked() {
    if [[ -e $FAKE_STATE/fail/$1 ]]; then
        echo "Error: Failed to $2 $1" >&2
        exit 1
    fi
}

case ${1-} in
    version)
        echo "Version: 2.10.5"
        ;;
    -q)
        # port -q installed [NAME]
        if [[ -n ${3-} ]]; then
            [[ -f $state/$3 ]] && echo "  $3 $(cat "$state/$3")"
        else
            for file in "$state"/*; do
                [[ -f $file ]] && echo "  ${file##*/} $(cat "$file")"
            done
        fi
        exit 0
        ;;
    select)
        # port select --show GROUP, port select --set GROUP TARGET
        mkdir -p "$FAKE_STATE/select"
        group=$3
        if [[ $2 == --show ]]; then
            echo "The currently selected version for '$group' is '$(cat "$FAKE_STATE/select/$group" 2>/dev/null || echo none)'."
        else
            need_root
            echo "$4" >"$FAKE_STATE/select/$group"
            echo "Selecting '$4' for '$group' succeeded. '$4' is now active."
        fi
        ;;
    -N)
        action=$2 name=$3
        need_root
        case $action in
            install)
                fail_if_asked "$name" install
                echo "--->  Installing $name @1.0_0"
                mkdir -p "$state"
                echo "@1.0_0 (active)" >"$state/$name"
                ;;
            uninstall)
                fail_if_asked "$name" uninstall
                [[ -f $state/$name ]] || { echo "Error: port $name not registered as installed." >&2; exit 1; }
                rm "$state/$name"
                echo "--->  Uninstalling $name @1.0_0"
                ;;
            *)
                echo "fake port: unsupported: $*" >&2
                exit 2
                ;;
        esac
        ;;
    *)
        echo "fake port: unsupported: $*" >&2
        exit 2
        ;;
esac
